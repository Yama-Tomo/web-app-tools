{
  "name": "@yamatomo/react-router-hono-bun-example",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "./scripts/install-workspace-packages",
    "build": "bunx --bun react-router build",
    "dev": "bunx --bun react-router dev",
    "start": "NODE_ENV=production ./build/server/server.js",
    "typecheck": "bun i && react-router typegen && tsc",
    "test": "bun i && pnpm '/test:.*/'",
    "test:dev": "TEST_TARGET=dev playwright test",
    "test:prod": "bun run build && playwright test"
  },
  "dependencies": {
    "@react-router/node": "^7.14.1",
    "@react-router/serve": "^7.14.1",
    "isbot": "^5.1.44",
    "react": "^19.2.7",
    "react-dom": "^19.2.5",
    "react-router": "^7.14.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@react-router/dev": "^7.14.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "msw": "^2.14.6",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^7.3.2",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "patchedDependencies": {
    "vite@7.3.6": "patches/vite@7.3.6.patch"
  }
}
