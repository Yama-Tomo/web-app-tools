{
  "name": "@yamatomo/web-app-tools",
  "private": true,
  "scripts": {
    "prepare": "pnpm build",
    "build": "pnpm --aggregate-output -F='./packages/*' build",
    "test": "pnpm --aggregate-output -F='./packages/*' --parallel test",
    "lint": "biome ci",
    "lint:fix": "biome check --write",
    "typecheck": "pnpm --aggregate-output -F='./packages/*' --parallel typecheck"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.14.1"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "10.33.0"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.9",
    "tsdown": "^0.22.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
